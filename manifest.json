{
  "manifest_version": 3,
  "name": "Waitwhile to PetPoint",
  "version": "0.1.0",
  "description": "Helps transfer and validate adopter information between Waitwhile and PetPoint.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://sms.petpoint.com/*",
    "https://*.waitwhile.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Waitwhile to PetPoint"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.waitwhile.com/*"
      ],
      "js": [
        "src/waitwhile/waitwhileContent.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:3000/*",
        "https://sms.petpoint.com/*"
      ],
      "js": [
        "src/petpoint/petpointContent.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
